# === Required backend variables ===
# Comma-separated key pool (>= 2 keys). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_primary_api_key_here,your_secondary_api_key_here
# Docker: 4 slashes = absolute path /data/app.db (named volume). Local dev: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend origin in production)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true

# === Optional backend configuration ===
LLM_MODEL=gemini/gemini-2.5-flash
# Optional per-key models, e.g. gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile
LLM_MODELS=
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
CACHE_ENABLED=true
# local = in-memory, disk = persisted under CACHE_DISK_DIR
CACHE_TYPE=local
CACHE_TTL_SECONDS=3600
CACHE_DISK_DIR=/data/litellm_cache
LLM_TIMEOUT_SECONDS=30

# === Frontend build-time variable (baked into the static bundle) ===
VITE_API_BASE_URL=http://localhost:8000
